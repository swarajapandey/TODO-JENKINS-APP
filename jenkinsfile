pipeline {
    agent any
    tools {
        nodejs 'NodeJS-LTS'
    }

    environment {
        APP_NAME = 'todo-jenkins-app'
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo 'Checking out code from GitHub...'
                checkout scm
            }
        }

        stage('2. Install Dependencies') {
            steps {
                echo 'Installing Node.js packages...'
                sh 'npm install'
            }
        }

        stage('3. Run Unit Tests') {
            steps {
                echo 'Executing Automated Tests...'
                sh 'npm test'
            }
        }

        stage('4. Build Summary') {
            steps {
                echo "App ${env.APP_NAME} built successfully!"
            }
        }
        
        stage('5. Deploy App via Docker') {
            steps {
                echo 'Building Docker Image...'
                // Build a docker image out of your app
                sh "docker build -t ${env.APP_NAME}:latest ."
                
                echo 'Deploying Container...'
                // Stop the old container if it exists so we don't get a port conflict
                sh "docker stop ${env.APP_NAME}-live || true"
                sh "docker rm ${env.APP_NAME}-live || true"
                
                // Run the new container and map port 3000 to your computer
                sh "docker run -d --name ${env.APP_NAME}-live -p 3000:3000 ${env.APP_NAME}:latest"
            }
        }        
    }

    post {
        always {
            echo 'Pipeline Execution Completed.'
            cleanWs() // This is now safe because the app is safely running inside Docker!
        }
        success {
            echo '🎉 BUILD AND DEPLOYMENT SUCCESSFUL!'
            echo '🚀 Open http://localhost:3000 in your browser to see your app!'
        }
        failure {
            echo '❌ BUILD FAILED!'
        }
    }
}
